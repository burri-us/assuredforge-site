{
  "name": "assuredforge-site",
  "version": "1.0.0",
  "private": true,
  "description": "The public AssuredForge website: a static export served by GitHub Pages",
  "type": "module",
  "scripts": {
    "dev": "node scripts/tokens.mjs && next dev",
    "build": "node scripts/tokens.mjs && node scripts/check-tokens.mjs && next build --webpack && node scripts/seo.mjs out && node scripts/check.mjs out && node scripts/check-fonts.mjs out",
    "check": "node scripts/check.mjs out",
    "check:fonts": "node scripts/check-fonts.mjs out",
    "check:switch": "node scripts/check-switch.mjs"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.29",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
